{
  "name": "kneczaj-theme-dark",
  "version": "1.0.0",
  "displayName": "Dark Theme by KNeczaj",
  "description": "Dark theme mainly for typescript",
  "publisher": "kneczaj",
  "license": "MIT",
  "scripts": {
    "build": "node ./scripts/build.js",
    "build:watch": "nodemon --watch ./src/* ./scripts/build.js",
    "lint": "node ./scripts/lint.js",
    "package": "vsce package -o ./bin/kneczaj-dark.vsix",
    "vscode:prepublish": "npm run build",
    "vsce-publish": "vsce publish"
  },
  "maintainers": [
    "Kamil Neczaj"
  ],
  "contributors": [
    "Lucas de França (luxonauta)",
    "Zeno Rocha",
    "Krzysztof Wisznarewski",
    "Daniel Ramos",
    "Eric Jackson",
    "Elliott Pogue",
    "Ajit Singh",
    "Teddy Bradford"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kneczaj/vcs-theme-dark.git"
  },
  "bugs": {
    "url": "https://github.com/kneczaj/vcs-theme-dark/issues"
  },
  "engines": {
    "vscode": "^1.13.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "dark",
    "theme",
    "color-theme"
  ],
  "icon": "icon.svg",
  "galleryBanner": {
    "color": "#3c4557",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Dark theme by KNeczaj",
        "uiTheme": "vs-dark",
        "path": "./theme/dark.json"
      },
      {
        "label": "Dark theme soft by KNeczaj",
        "uiTheme": "vs-dark",
        "path": "./theme/dark-soft.json"
      }
    ]
  },
  "devDependencies": {
    "js-yaml": "^4.1.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.0.0",
    "tinycolor2": "^1.6.0",
    "vsce": "^2.15.0"
  }
}
